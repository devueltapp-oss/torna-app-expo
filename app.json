{
  "expo": {
    "name": "Torna",
    "slug": "tornapp",
    "owner": "teamtornas-organization",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/torna-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/torna-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1E47"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Torna usa tu ubicación para avisarte de partidas abiertas cerca tuyo. No se muestra a nadie ni se comparte con otros jugadores.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "./plugins/withNonModularHeaders"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.Tornapp",
      "buildNumber": "8",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Torna accede a tu galería para subir fotos y videos.",
        "NSPhotoLibraryAddUsageDescription": "Torna guarda clips en tu galería.",
        "NSLocationWhenInUseUsageDescription": "Torna usa tu ubicación para avisarte de partidas abiertas cerca tuyo. No se muestra a nadie ni se comparte con otros jugadores."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestampAPIs",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/torna-icon.png",
        "backgroundColor": "#0F1E47"
      },
      "package": "io.torna",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/torna-icon.png"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "OneSignalNotificationServiceExtension",
                  "bundleIdentifier": "com.Tornapp.OneSignalNotificationServiceExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.Tornapp.onesignal"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6a3a7eab-f27e-4225-989f-4331a6fc578e"
      }
    }
  }
}
